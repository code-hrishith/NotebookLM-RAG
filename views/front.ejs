<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RAG Browser App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <style>
      .chat-container {
        height: calc(100vh - 200px);
      }
      .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
      }
    </style>
  </head>
  <body class="bg-slate-50 font-sans">
    <div class="flex h-screen">
      <aside
        class="w-80 bg-white border-r border-slate-200 p-6 flex flex-col gap-6 overflow-y-auto"
      >
        <div>
          <h1 class="text-xl font-bold text-slate-800 mb-2">RAG Engine</h1>
          <p
            class="text-xs text-slate-500 uppercase tracking-wider font-semibold"
          >
            Data Ingestion
          </p>
        </div>

        <div class="space-y-2">
          <!-- <label class="text-sm font-medium text-slate-700">Website URL</label>
          <input
            type="url"
            id="urlInput"
            placeholder="https://example.com"
            class="w-full p-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 outline-none"
          />
        </div> -->
        <form action="/upload/file" method="post" enctype="multipart/form-data">
            <!-- //////////////////////////////////////////////// -->
          <div class="space-y-2">
            <label class="text-sm font-medium text-slate-700"
              >Upload Files (PDF/CSV)</label
            >
            <div
              class="border-2 border-dashed border-slate-300 rounded-lg p-4 text-center hover:border-blue-400 transition-colors"
            >
              <input type="file" id="fileInput" name="files" class="hidden" multiple />
              <label
                for="fileInput"
                class="cursor-pointer text-sm text-slate-600"
              >
                <i
                  class="fa-solid fa-cloud-arrow-up text-2xl mb-2 text-slate-400"
                ></i
                ><br />
                Click to upload
              </label>
            </div>
            <div id="fileList" class="text-xs text-slate-500 mt-1"></div>
          </div>
        </form>
        
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700"
            >Raw Data Source</label
          >
          <textarea
            id="textSource"
            rows="4"
            placeholder="Paste extra context here..."
            class="w-full p-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 outline-none"
          ></textarea>
        </div>

        <button
          onclick="indexData()"
          class="w-full bg-blue-600 text-white py-2 rounded-md font-semibold hover:bg-blue-700 transition-all shadow-md active:scale-95"
        >
          <i class="fa-solid fa-database mr-2"></i> Index into RAG Store
        </button>

        <div class="mt-auto border-t pt-4">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
            <span class="text-sm text-slate-600 font-medium"
              >RAG Store: Ready</span
            >
          </div>
        </div>
      </aside>

      <main class="flex-1 flex flex-col">
        <header
          class="bg-white border-b border-slate-200 p-4 flex justify-between items-center"
        >
          <h2 class="text-lg font-semibold text-slate-700">
            Knowledge Assistant
          </h2>
          <button
            onclick="clearChat()"
            class="text-slate-400 hover:text-red-500 transition-colors"
          >
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </header>

        <div
          id="chatWindow"
          class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar bg-slate-50"
        >
          <div class="flex gap-3 max-w-3xl">
            <div
              class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 shrink-0"
            >
              <i class="fa-solid fa-robot text-sm"></i>
            </div>
            <div
              class="bg-white border border-slate-200 p-3 rounded-2xl rounded-tl-none shadow-sm text-slate-700"
            >
              Hello! Index some data on the left to start querying your personal
              knowledge base.
            </div>
          </div>
        </div>

        <div class="p-4 bg-white border-t border-slate-200">
          <div class="max-w-4xl mx-auto flex gap-2">
            <input
              type="text"
              id="userInput"
              placeholder="Ask a question about your data..."
              class="flex-1 p-3 bg-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <button
              onclick="handleSendMessage()"
              class="bg-blue-600 text-white p-3 rounded-xl hover:bg-blue-700 shadow-md"
            >
              <i class="fa-solid fa-paper-plane px-1"></i>
            </button>
          </div>
        </div>
      </main>
    </div>

    <script src="backend.js"></script>
  </body>
</html>
